# Copy to .env beside Companion.exe (or in the source checkout), then restart.
# Local AI requires the separately installed model and speech services.
# Start them with Companion's local launcher before asking a question.
COMPANION_PROVIDER=local
COMPANION_LOCAL_MODEL=companion-math

# Optional cloud alternative: replace COMPANION_PROVIDER=local above with openai,
# then uncomment these two settings. Cloud questions and audio go to OpenAI.
# OPENAI_API_KEY=your-api-key-here
# COMPANION_MODEL=gpt-6.1-sol

# Never commit .env. Reading, plots and notes work without either AI service.
